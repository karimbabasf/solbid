# One provider set, never mixed. OpenRouter today; NEAR_AI_* is used only when LLM_API_KEY is empty.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-flash
LLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=openai/gpt-oss-120b
PUBLIC_URL=
ENTER_URL=
BOTS=3
